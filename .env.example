# Required — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM provider for chat generation (default: gemini)
# Options: gemini | claude | openai
LLM_PROVIDER=gemini

# Search method for document retrieval (default: hybrid)
# Options: hybrid | semantic
SEARCH_METHOD=hybrid

# Required only if LLM_PROVIDER=claude
CLAUDE_API_KEY=

# Required only if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Cloudflare Workers — configured via wrangler.toml, not .env

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile — get keys from https://dash.cloudflare.com → Turnstile
# Test keys (always-pass, safe for dev): site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
